# Sem NENHUMA destas variáveis, o app roda em MODO DEMO (dados em memória +
# concierge determinístico). Preencha para ativar as integrações reais.

# ---- Claude (Anthropic) — ativa os agentes de IA reais ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase — ativa o banco real ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # SÓ no backend — nunca no client

# ---- Google Calendar (OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# ---- E-mail (Resend) ----
RESEND_API_KEY=
RESEND_FROM=AgendaBio <no-reply@agendabio.com.br>

# ---- Pagamento (Stripe) — sem isto, o onboarding roda em modo stub ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...        # do endpoint /api/webhooks/stripe
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron ----
CRON_SECRET=troque-por-um-segredo-forte
